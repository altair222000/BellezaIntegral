# Opcionales. Agregar a .env solo si corresponde a tu entorno.
# El visor integrado comparte origen; NO necesita CORS_ORIGINS.
# Frontend separado durante desarrollo:
# CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
# MySQL remoto con certificado de confianza:
# DB_SSL_CA=C:/certificados/mysql-ca.pem
