# Copia este archivo como .env.remote en tu PC.
# .env.remote está ignorado por Git: NO subas credenciales reales.

REMOTE_DB_HOST=mysql.ejemplo.com
REMOTE_DB_PORT=3306
REMOTE_DB_NAME=belleza_integral
REMOTE_DB_USER=belleza_app

# Opcional. Es más seguro dejarla vacía y escribirla cuando el script la solicite.
# REMOTE_DB_PASSWORD=

# Opcional si tu proveedor exige certificado CA.
# REMOTE_DB_SSL_CA=C:\\certificados\\ca.pem
